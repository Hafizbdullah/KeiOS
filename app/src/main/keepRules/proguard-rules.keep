# ---------- KeiOS R8 baseline ----------
# Keep enum member names stable only where stores or protocol payloads persist enum.name.
-keepclassmembernames enum os.kei.core.prefs.AppThemeMode { *; }
-keepclassmembernames enum os.kei.feature.home.model.HomeOverviewCard { *; }
-keepclassmembernames enum os.kei.ui.page.main.model.BottomPage { *; }
-keepclassmembernames enum os.kei.ui.page.main.os.OsSectionCard { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubDirectApkRemoteHealth { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubReleaseChannel { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubRepositoryProfilePurpose { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubRepositoryProfileCapability { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubRepositoryProfileSource { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubRepositoryProfileAvailabilityStatus { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubRepositoryProfileConfidence { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubStarImportQuality { *; }
-keepclassmembernames enum os.kei.feature.github.model.GitHubStarImportApkVerificationStatus { *; }
-keepclassmembernames enum os.kei.ui.page.main.github.importer.StarImportViewFilter { *; }
-keepclassmembernames enum os.kei.ui.page.main.github.importer.StarImportConflictStrategy { *; }
-keepclassmembernames enum os.kei.ui.page.main.github.importer.StarImportUiSource { *; }
-keepclassmembernames enum os.kei.ui.page.main.github.share.GitHubShareImportPhase { *; }
-keepclassmembernames enum os.kei.ui.page.main.student.catalog.BaGuideCatalogTab { *; }
-keepclassmembernames enum os.kei.ui.page.main.student.catalog.component.BaGuideBgmQueueMode { *; }
-keepclassmembernames enum os.kei.mcp.server.McpToolExecutionProfile { *; }

# WebDavSyncItem and WebDavProvider enum constant names are persisted as MMKV key
# suffixes (`enabled_<name>`, `last_sync_<name>`, etc.) and as the saved provider id
# (`WebDavSyncStore.saveConfig` writes `provider.name`). Renaming would orphan user data
# on every release. Keep the names, allow class-name obfuscation and member optimization.
-keepclassmembernames enum os.kei.ui.page.main.sync.WebDavSyncItem { *; }
-keepclassmembernames enum os.kei.ui.page.main.sync.WebDavProvider { *; }

# dav4jvm WebDAV library
#
# Confirmed via bytecode scan of dav4jvm-main-SNAPSHOT.jar (no Class.forName, no
# ServiceLoader, no getDeclared*): the property pipeline is fully statically traceable.
# `PropertyRegistry.<clinit>` references every `<Property>$Factory.INSTANCE` via
# `getstatic`, and the XML parser invokes `Factory.create()` via the `PropertyFactory`
# interface — both paths R8 follows on its own. The previous broad keep rules
# (`Property`, `PropertyFactory`, `extends PropertyFactory`, and `property.**`) were
# redundant and the `extends` rule matched zero classes (factories implement, not
# extend, the interface). They were dropped after a release build verified the
# property graph is still reached transitively.

# Keep internal component class names stable for manifest lookups and About-page introspection.
# This covers future KeiOS activities/services/receivers/providers without needing manual updates.
-keepnames class os.kei.** extends android.app.Application
-keepnames class os.kei.** extends android.app.Activity
-keepnames class os.kei.** extends android.app.Service
-keepnames class os.kei.** extends android.content.BroadcastReceiver
-keepnames class os.kei.** extends android.content.ContentProvider

# Keep Miuix Nav route key type and Kotlin serialization entry points.
# Route classes are referenced directly by entry<T>; keep only restore/serializer anchors.
-keep,allowoptimization,allowobfuscation interface os.kei.ui.navigation.KeiosRoute
-keep,allowoptimization,allowobfuscation class os.kei.ui.navigation.KeiosRoute$*$$serializer { *; }
-keepclassmembers,allowoptimization,allowobfuscation class os.kei.ui.navigation.KeiosRoute$* {
    public static ** Companion;
    public static ** INSTANCE;
    public static *** serializer(...);
}

# Keep annotation/signature metadata used by Kotlin + library runtime features.
-keepattributes Signature,InnerClasses,EnclosingMethod,*Annotation*

# Module-specific rules:
# - core-notification exports local Focus V3 and Super Island facade consumer rules.
# - core-system exports Shizuku and HiddenApiBypass consumer rules.
# - feature-github keeps its managed-install Shizuku bridge surface.

# Drop direct release Log calls to reduce overhead and method count.
# AppLogger warning/error paths are kept visible for benchmark/release install diagnostics.
-assumenosideeffects class android.util.Log {
    public static int v(...);
    public static int d(...);
    public static int i(...);
}

# Ktor debug probe references JDK-only management APIs on Android.
-dontwarn java.lang.management.ManagementFactory
-dontwarn java.lang.management.RuntimeMXBean

# R8 diagnostics:
# - Compare app/build/outputs/mapping/{release,benchmark}/configuration.txt, mapping.txt, and usage.txt.
# - Use temporary -whyareyoukeeping rules only during local diagnosis; do not commit them.
