<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome BA daily-done mark, shared by the Quick Settings tiles and the launcher shortcuts.

    Black rather than white, for two independent reasons that happen to agree. A QS tile icon is
    tinted by the system per active state, so its source colour is discarded either way — the proof
    is that the previous white copy of this file rendered *black* in the tile editor's light chrome.
    A launcher shortcut is not tinted, and both sibling shortcut icons here (ic_mcp_lobehub,
    ic_github_invertocat) are #FF000000, because shortcut chrome is light.

    So one asset serves both, and the name says `mono` rather than `tile` because the shortcuts use
    it too. The island/notification copy in core-notification is deliberately white instead: those
    surfaces draw on dark plates, and its siblings there are white too.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Own artwork, in the S.C.H.A.L.E. family rather than a copy of anyone's logo.

        Elements borrowed from the emblem the app already uses for BA identity
        (`ic_ba_schale`, the in-game club emblem, MIT / Avrona): the halo above, the ringed
        crosshair below. Redrawn far bolder, because that asset's 6-11 unit strokes on an 1800
        viewport dissolve at a 48px tile — visibly so when the two are rendered side by side.

        The distinguishing element is the tick in the ring, and it is there for the same reason
        SchaleDB adds its own mark to the BA shapes: `ic_ba_schale` is already the BA *tab* icon, so
        an untouched emblem here would say "BA" and not "BA dailies". The crosshair arms retract to
        four inward ticks to make room for it, which keeps the silhouette recognisable while freeing
        the centre.

        Single colour throughout, no hardcoded fills: a QS tile icon is tinted by the system per
        active state, so any second colour renders wrong in one of the two states. That also rules
        out the badge treatment this replaced.
    -->
        <!-- halo -->
        <path
            android:fillColor="#00000000"
            android:pathData="M7.5,4.9a4.5,1.35 0 1,0 9,0a4.5,1.35 0 1,0 -9,0"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.3" />
        <!-- ring -->
        <path
            android:fillColor="#00000000"
            android:pathData="M7,13.3a5,5 0 1,0 10,0a5,5 0 1,0 -10,0"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.55" />
        <!-- crosshair, retracted to inward ticks -->
        <path
            android:fillColor="#00000000"
            android:pathData="M2.4,13.3L7.6,13.3"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M16.4,13.3L21.6,13.3"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M12,3.3L12,7.9"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <path
            android:fillColor="#00000000"
            android:pathData="M12,18.7L12,21.5"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.2"
            android:strokeLineCap="round" />
        <!-- the tick: what makes this the dailies-done mark rather than the BA mark -->
        <path
            android:fillColor="#00000000"
            android:pathData="M9.6,13.4l1.7,1.7l3.2,-3.8"
            android:strokeColor="#FF000000"
            android:strokeWidth="1.7"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
</vector>
